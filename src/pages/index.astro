---
import Layout from "../layouts/Layout.astro";
import ProductCard from "../components/ProductCard.astro";
import { getCollection } from "astro:content";

const products = await getCollection("products");
---

<Layout
    title="Victor Pass"
    description="Focused tools, built in the open. Victor Pass is one engineer in Colorado Springs, targetting local work."
    overlay
>
    <section class="hero">
        <img
            class="hero-image"
            src="/images/gold-camp-road.webp"
            srcset="/images/gold-camp-road-1000.webp 1000w, /images/gold-camp-road.webp 2000w"
            sizes="100vw"
            alt="Granite spires above a mountain meadow along the dirt road up to Victor, Colorado"
            fetchpriority="high"
        />

        <div class="container hero-content">
            <p class="eyebrow">Victor Pass Development · Colorado Springs</p>

            <h1 class="display">Focused tools, built in the open.</h1>

            <p class="lede">
                Victor Pass is one engineer. I build my own tools, and I'm
                straightforward about how they're run and paid for.
            </p>

            <p class="availability">
                Taking on local work in Colorado Springs: focused jobs, not
                sprawling ones.
            </p>

            <div class="actions">
                <a class="button primary" href="/about/#work">
                    Work with me →
                </a>
                <a class="button ghost" href="/products/">
                    Explore products
                </a>
            </div>
        </div>
    </section>

    <section class="container products-section">
        <div class="section-head">
            <div>
                <p class="eyebrow">Projects</p>
                <h2 class="section-title">Recent work.</h2>
            </div>
            <p>
                What I'm building and running now. Each one has a free live
                demo.
            </p>
        </div>

        <div class="products">
            {products.map((product) => (
                <ProductCard product={product} />
            ))}
        </div>
    </section>

    <section class="container features" aria-label="How I build">
        <article>
            <span class="number">01</span>
            <h3>Small enough to understand</h3>
            <p>
                Interface simplicity first, internal simplicity second.
                Complicated software is slow and risky to update; small keeps
                quality high and changes easy.
            </p>
        </article>

        <article>
            <span class="number">02</span>
            <h3>Evidence based</h3>
            <p>
                I've benchmarked my own "optimizations" before and found I was
                measuring noise. I don't assume I'm correct; I verify it.
            </p>
        </article>

        <article>
            <span class="number">03</span>
            <h3>Open development</h3>
            <p>
                I share work early and often, so we can find the best solution
                together. Ideas that don't work out get dropped in the open, not
                hidden.
            </p>
        </article>
    </section>

    <section class="container closing">
        <p class="lede">
            If some part of your work is slow, manual, or held together by a
            spreadsheet nobody wants to touch, I'd like to hear about it.
        </p>
        <a class="button primary" href="/about/#work">
            Work with me →
        </a>
    </section>
</Layout>

<style>
    .hero {
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        min-height: min(92vh, 900px);
        padding: 8rem 0 2rem;
        overflow: hidden;
        background: var(--ink);
        color: #fff;
        isolation: isolate;
    }

    .hero-image {
        position: absolute;
        inset: 0;
        z-index: -2;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: 50% 35%;
    }

    .hero::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        background:
            linear-gradient(
                to top,
                rgb(10 20 18 / 88%) 0%,
                rgb(10 20 18 / 55%) 40%,
                rgb(10 20 18 / 10%) 75%,
                rgb(10 20 18 / 35%) 100%
            ),
            linear-gradient(to right, rgb(10 20 18 / 45%), transparent 70%);
    }

    .hero-content {
        padding-bottom: 3rem;
    }

    .hero .eyebrow {
        color: var(--granite);
    }

    .hero .display {
        max-width: 14ch;
        text-shadow: 0 2px 24px rgb(0 0 0 / 25%);
    }

    .hero .lede {
        color: rgb(255 255 255 / 82%);
    }

    .availability {
        margin: 1.5rem 0 0;
        color: var(--granite);
        font-weight: 600;
    }

    .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 2.25rem;
    }

    .hero .button.primary {
        background: var(--paper);
        border-color: var(--paper);
        color: var(--ink);
    }

    .hero .button.primary:hover {
        background: #fff;
        border-color: #fff;
    }

    .button.ghost {
        background: rgb(255 255 255 / 8%);
        border-color: rgb(255 255 255 / 35%);
        color: #fff;
        backdrop-filter: blur(6px);
    }

    .button.ghost:hover {
        border-color: #fff;
    }

    .caption {
        margin: 0;
        color: rgb(255 255 255 / 55%);
        font-size: 0.75rem;
        letter-spacing: 0.08em;
        text-align: right;
        text-transform: uppercase;
    }

    .products-section {
        padding-top: 6rem;
    }

    .section-head {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        justify-content: space-between;
        gap: 1rem 3rem;
        margin-bottom: 2.5rem;
    }

    .section-head > p {
        max-width: 24rem;
        margin: 0;
        color: var(--muted);
        line-height: 1.6;
    }

    .products {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
        gap: 1.5rem;
    }

    .features {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2.5rem;
        margin-top: 6rem;
        padding-top: 3rem;
        border-top: 1px solid var(--border);
    }

    .number {
        color: var(--clay);
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.85rem;
        font-weight: 600;
    }

    .features h3 {
        margin: 0.75rem 0 0.5rem;
        font-size: 1.2rem;
        letter-spacing: -0.015em;
    }

    .features p {
        margin: 0;
        color: var(--muted);
        line-height: 1.65;
    }

    .closing {
        margin-top: 5rem;
    }

    .closing .lede {
        margin: 0 0 1.75rem;
    }

    @media (max-width: 760px) {
        .hero {
            min-height: 85vh;
            padding-top: 6rem;
        }

        .features {
            grid-template-columns: 1fr;
            gap: 2rem;
        }
    }
</style>
