---
import Layout from "../layouts/Layout.astro";
import ProductCard from "../components/ProductCard.astro";
import { getCollection } from "astro:content";

const products = await getCollection("products");
---

<Layout title="Victor Pass">
    <section class="hero">
        <div class="hero-content">
            <p class="eyebrow">Victor Pass Development · Colorado Springs</p>

            <h1>I build small tools, in public.</h1>

            <p class="lede">
                Victor Pass is one engineer. I write software with a bias toward
                tools small enough to keep in your head, and I'd rather ship one
                thing properly than four things badly.
            </p>

            <div class="actions">
                <a class="button primary" href="/products/">
                    Explore products
                </a>
                <a class="button" href="/about/">
                    About Victor Pass
                </a>
            </div>
        </div>

        <div class="logo">
            <img src="/VictorPass.logo.png" alt="Victor Pass logo" />
        </div>
    </section>

    <section class="features" aria-label="What I build">
        <article>
            <span class="number">01</span>
            <h2>Small enough to understand</h2>
            <p>
                Interface simplicity first, internal simplicity second. A tool I
                can't hold in my head is one I'll eventually be afraid to
                change.
            </p>
        </article>

        <article>
            <span class="number">02</span>
            <h2>Evidence over instinct</h2>
            <p>
                I've benchmarked my own "optimizations" before and found I was
                measuring noise. Checking is cheaper than assuming.
            </p>
        </article>

        <article>
            <span class="number">03</span>
            <h2>Ideas stay visible</h2>
            <p>
                Not every idea becomes a product. I'd rather show the ones that
                didn't pan out than pretend only the successes happened.
            </p>
        </article>
    </section>

    <section class="callout">
        <p class="eyebrow">Currently building</p>
        <h2>Tools in progress.</h2>
        <p>What I'm building at Victor Pass right now, with live demos.</p>

        <div class="products">
            {products.map((product) => (
                <ProductCard product={product} />
            ))}
        </div>
    </section>
</Layout>

<style>
    .hero {
        min-height: 70vh;
        display: grid;
        grid-template-columns: 1.5fr 1fr;
        align-items: center;
        gap: 4rem;
        padding: 5rem 0;
    }

    .eyebrow {
        margin: 0 0 1rem;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        font-size: 0.8rem;
        font-weight: 700;
        opacity: 0.65;
    }

    h1 {
        max-width: 800px;
        margin: 0;
        font-size: clamp(3rem, 7vw, 6rem);
        line-height: 0.95;
        letter-spacing: -0.04em;
    }

    .lede {
        max-width: 650px;
        margin: 2rem 0;
        font-size: 1.25rem;
        line-height: 1.6;
        opacity: 0.75;
    }

    .logo {
        display: grid;
        place-items: center;
    }

    .logo img {
        width: min(100%, 420px);
        height: auto;
        filter: drop-shadow(0 1rem 2rem rgb(0 0 0 / 15%));
        transition: transform 500ms ease;
    }

    .logo img:hover {
        transform: rotate(-2deg) scale(1.03);
    }

    .actions {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .button {
        display: inline-block;
        padding: 0.8rem 1.2rem;
        border: 1px solid currentColor;
        border-radius: 999px;
        text-decoration: none;
        transition:
            transform 150ms ease,
            background 150ms ease;
    }

    .button:hover {
        transform: translateY(-2px);
    }

    .button.primary {
        background: currentColor;
        color: var(--page-background);
    }

    .features {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2rem;
        padding: 5rem 0;
        border-top: 1px solid color-mix(in srgb, currentColor 20%, transparent);
    }

    .features article {
        padding: 1.5rem 0;
    }

    .number {
        font-family: monospace;
        opacity: 0.5;
    }

    .features h2 {
        margin: 1rem 0 0.5rem;
    }

    .features p {
        line-height: 1.6;
        opacity: 0.7;
    }

    .callout {
        padding: 5rem;
        margin: 2rem 0 5rem;
        border-radius: 1.5rem;
        background: color-mix(in srgb, currentColor 7%, transparent);
    }

    .callout h2 {
        margin: 0;
        font-size: clamp(2rem, 5vw, 4rem);
    }

    .callout > p:not(.eyebrow) {
        max-width: 600px;
        line-height: 1.6;
        opacity: 0.7;
    }

    .callout .products {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.5rem;
        margin-top: 3rem;
    }

    .callout .products :global(.product) {
        background: var(--page-background);
    }

    @media (max-width: 700px) {
        .hero {
            grid-template-columns: 1fr;
            padding: 3rem 0;
        }

        .logo {
            order: -1;
        }

        .features {
            grid-template-columns: 1fr;
        }

        .callout {
            padding: 2rem;
        }
    }
</style>
