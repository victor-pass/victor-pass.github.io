---
interface Props {
    title?: string;
}

const { title = "Victor Pass" } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/png" href="/VictorPass.logo.png" />
        <meta name="description" content="Victor Pass Development" />
        <title>{title}</title>
    </head>

    <body>
        <header>
            <nav>
                <a class="brand" href="/">
                    <img class="icon" src="/icon.svg" /> Victor Pass
                </a>

                <div class="links">
                    <a href="/products/">Products</a>
                    <a href="/about/">About</a>
                </div>
            </nav>
        </header>

        <main>
            <slot />
        </main>

        <footer>
            <p>© {new Date().getFullYear()} Victor Pass Development</p>
        </footer>
    </body>
</html>

<style>
    :global(:root) {
        --page-background: #faf9f6;
        --text: #1c1c1a;
        --muted: #666660;
        --border: #deded8;
        --content-width: 1100px;
    }

    :global(*) {
        box-sizing: border-box;
    }

    :global(html) {
        background: var(--page-background);
        color: var(--text);
        font-family:
            system-ui,
            -apple-system,
            BlinkMacSystemFont,
            "Segoe UI",
            sans-serif;
    }

    :global(body) {
        margin: 0;
        min-height: 100vh;
    }

    :global(a) {
        color: inherit;
    }

    header {
        border-bottom: 1px solid var(--border);
    }

    nav {
        max-width: var(--content-width);
        margin: 0 auto;
        padding: 1.25rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .brand {
        font-size: 1.1rem;
        font-weight: 700;
        text-decoration: none;
        letter-spacing: -0.02em;
    }

    img.icon {
        height: 2rem;
    }

    .links {
        display: flex;
        gap: 1.5rem;
    }

    .links a {
        color: var(--muted);
        text-decoration: none;
    }

    .links a:hover {
        color: var(--text);
    }

    main {
        max-width: var(--content-width);
        margin: 0 auto;
        padding: 0 1.25rem;
    }

    footer {
        max-width: var(--content-width);
        margin: 0 auto;
        padding: 3rem 1.25rem;
        color: var(--muted);
        font-size: 0.85rem;
    }
</style>
