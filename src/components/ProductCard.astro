---
import type { CollectionEntry } from "astro:content";

interface Props {
    product: CollectionEntry<"products">;
}

const { product } = Astro.props;
---

<a class:list={["product", { "has-phone": product.data.screenshots?.[0] }]} href={`/products/${product.id}/`}>
    {product.data.screenshots?.[0] && (
        <img
            class="phone"
            src={`/products/${product.id}/shot-0.webp`}
            alt={`${product.data.title} on a phone`}
            loading="lazy"
        />
    )}
    <div class="body">
        <span class="status">{product.data.status}</span>
        <h3>{product.data.title}</h3>
        <p>{product.data.description}</p>
        <span class="more">Learn more <span aria-hidden="true">→</span></span>
    </div>
</a>

<style>
    /* The phone screenshot (transparent PNG → webp) sits beside the text
       at its own aspect ratio. */
    .product {
        display: flex;
        align-items: center;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        background: var(--surface);
        color: inherit;
        text-decoration: none;
        transition:
            transform 250ms var(--ease),
            box-shadow 250ms var(--ease),
            border-color 250ms ease;
    }

    .product:hover {
        transform: translateY(-4px);
        box-shadow: var(--shadow);
        border-color: color-mix(in srgb, var(--ink) 25%, var(--border));
    }

    .phone {
        flex: none;
        width: clamp(5.5rem, 24vw, 7rem);
        height: auto;
        margin: 1.25rem 0 1.25rem 1.25rem;
        filter: drop-shadow(0 12px 16px rgb(18 33 30 / 20%));
        transition: transform 400ms var(--ease);
    }

    .product:hover .phone {
        transform: rotate(-2deg);
    }

    .body {
        display: flex;
        flex: 1;
        flex-direction: column;
        align-self: stretch;
        padding: 1.5rem 1.75rem 1.75rem;
    }

    .has-phone .body {
        padding-left: 1rem;
    }

    .status {
        align-self: flex-start;
        padding: 0.3rem 0.65rem;
        border-radius: 999px;
        background: color-mix(in srgb, var(--accent) 10%, transparent);
        color: var(--accent);
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    h3 {
        margin: 1rem 0 0.4rem;
        font-size: 1.4rem;
        letter-spacing: -0.02em;
    }

    p {
        flex: 1;
        margin: 0 0 1.25rem;
        color: var(--muted);
        line-height: 1.6;
    }

    .more {
        font-size: 0.9rem;
        font-weight: 600;
    }

    .more span {
        display: inline-block;
        transition: transform 200ms var(--ease);
    }

    .product:hover .more span {
        transform: translateX(4px);
    }
</style>
